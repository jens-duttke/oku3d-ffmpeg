From 251fcfd073c6fedd1e5b1ebe48e236fa049c10bc Mon Sep 17 00:00:00 2001
From: Jens Duttke <jens@duttke.de>
Date: Thu, 19 Nov 2026 14:01:02 +0100
Subject: [PATCH] avcodec/hevc/hevcdec: start the last layer's picture before
 decoding base-layer slices

With frame threading, the next access unit may start once
ff_thread_finish_setup() has been called, which for a multi-layer stream
happens when the picture of the last layer to be decoded is started: the
next unit refers to every layer's picture. In bitstream order that picture
starts only after every base-layer slice of the access unit is decoded,
so base-layer pictures of consecutive access units never decode in
parallel and a two-view MV-HEVC stream keeps about two cores busy
whatever the thread count.

When the base layer's picture has just been started and nothing but AUD
or filler data NAL units lies between its first slice and the first slice
of the last layer to start, start that layer's picture right away and
call ff_thread_finish_setup() there. Decoding base-layer slice data
changes none of the state the next thread copies, so it copies exactly
what the original order leaves after that layer's start. The per-picture
state the base layer goes on decoding with is put back afterwards, and the
started layer's is kept until decoding reaches its first slice, where it
is put back in turn instead of starting the picture again. A picture
started this way whose slices are never reached is dropped without being
output. Any other layout, hardware acceleration and slice threading keep
the original order.

A 3840x2160-per-view 10-bit 48 fps MV-HEVC film, 20 s decoded to null on
a 16-core Ryzen 9 9950X, went from 0.73x to 1.92x realtime with 16 frame
threads, from 0.73x to 1.41x with 8 and from 0.75x to 1.04x with 4. Its
output, that of an Apple spatial video and that of the FATE multiview
samples is byte-identical to the unpatched decoder at 1, 2 and 16 frame
threads, fate-hevc gives the same results, and AddressSanitizer reports
nothing on these streams or on ones with corrupted enhancement-layer
slice headers.
---
 libavcodec/hevc/hevcdec.c | 191 +++++++++++++++++++++++++++++++++++---
 libavcodec/hevc/hevcdec.h |  27 ++++++
 2 files changed, 206 insertions(+), 12 deletions(-)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index a3be41a..f52ae56 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -3517,6 +3517,164 @@ static int hevc_frame_end(HEVCContext *s, HEVCLayerContext *l)
     return 0;
 }
 
+/* whether the slice whose header is in s->sh is dropped undecoded */
+static int slice_is_skipped(const HEVCContext *s)
+{
+    return (s->avctx->skip_frame >= AVDISCARD_BIDIR && s->sh.slice_type == HEVC_SLICE_B) ||
+           (s->avctx->skip_frame >= AVDISCARD_NONINTRA && s->sh.slice_type != HEVC_SLICE_I) ||
+           (s->avctx->skip_frame >= AVDISCARD_NONKEY && !IS_IRAP(s)) ||
+           ((s->nal_unit_type == HEVC_NAL_RASL_R || s->nal_unit_type == HEVC_NAL_RASL_N) &&
+            s->no_rasl_output_flag);
+}
+
+/* move the per-picture state out of the context; the PPS reference moves too */
+static void picture_state_take(HEVCContext *s, HEVCPictureState *st)
+{
+    st->pps            = s->pps;
+    s->pps             = NULL;
+    st->nal_unit_type  = s->nal_unit_type;
+    st->first_nal_type = s->first_nal_type;
+    st->nuh_layer_id   = s->nuh_layer_id;
+    st->temporal_id    = s->temporal_id;
+    st->poc            = s->poc;
+    st->slice_idx      = s->slice_idx;
+    st->cur_frame      = s->cur_frame;
+    st->collocated_ref = s->collocated_ref;
+    memcpy(st->rps, s->rps, sizeof(s->rps));
+    st->end_of_tiles_x = s->local_ctx[0].end_of_tiles_x;
+}
+
+/* move a state taken by picture_state_take() back into the context */
+static void picture_state_put(HEVCContext *s, HEVCPictureState *st)
+{
+    av_refstruct_unref(&s->pps);
+    s->pps             = st->pps;
+    st->pps            = NULL;
+    s->nal_unit_type   = st->nal_unit_type;
+    s->first_nal_type  = st->first_nal_type;
+    s->nuh_layer_id    = st->nuh_layer_id;
+    s->temporal_id     = st->temporal_id;
+    s->poc             = st->poc;
+    s->slice_idx       = st->slice_idx;
+    s->cur_frame       = st->cur_frame;
+    s->collocated_ref  = st->collocated_ref;
+    memcpy(s->rps, st->rps, sizeof(s->rps));
+    s->local_ctx[0].end_of_tiles_x = st->end_of_tiles_x;
+}
+
+/* exchange s->sh and s->sh_prestart, keeping a short-term RPS that points
+ * into a header's own storage pointing into that same header */
+static void swap_slice_headers(HEVCContext *s)
+{
+    int own_rps, own_rps_prestart;
+
+    FFSWAP(SliceHeader, s->sh, s->sh_prestart);
+
+    own_rps          = s->sh.short_term_rps          == &s->sh_prestart.slice_rps;
+    own_rps_prestart = s->sh_prestart.short_term_rps == &s->sh.slice_rps;
+    if (own_rps)
+        s->sh.short_term_rps = &s->sh.slice_rps;
+    if (own_rps_prestart)
+        s->sh_prestart.short_term_rps = &s->sh_prestart.slice_rps;
+}
+
+/*
+ * Frame threading lets the next access unit start once
+ * ff_thread_finish_setup() has been called, which for a multi-layer stream
+ * has to wait until every decoded layer's picture has been started: the
+ * next unit refers to all of them. Started in bitstream order, a non-base
+ * layer's picture starts only after every base-layer slice is decoded, so
+ * consecutive base-layer pictures never decode in parallel.
+ *
+ * When the base layer's picture has just been started and nothing but its
+ * own first slice stands between it and the first slice of the last layer
+ * to start, start that layer's picture right away and call
+ * ff_thread_finish_setup() there. The state the next thread copies is then
+ * exactly what the original order leaves after that layer's start, since
+ * decoding base-layer slice data changes none of it; the per-picture state
+ * the base layer goes on decoding with is put back afterwards and the
+ * started layer's is kept until decoding reaches its first slice.
+ */
+static void prestart_layer_picture(HEVCContext *s, unsigned nal_idx)
+{
+    const unsigned target = s->finish_setup_nal_idx;
+    const H2645NAL *nal;
+    HEVCPictureState base;
+    HEVCLayerContext *l;
+    GetBitContext gb;
+    int layer_idx, ret;
+
+    if (!(s->avctx->active_thread_type & FF_THREAD_FRAME) || s->avctx->hwaccel ||
+        target <= nal_idx || target >= s->pkt.nb_nals)
+        return;
+
+    for (unsigned i = nal_idx + 1; i < target; i++) {
+        if (s->pkt.nals[i].type != HEVC_NAL_AUD &&
+            s->pkt.nals[i].type != HEVC_NAL_FD_NUT)
+            return;
+    }
+
+    nal = &s->pkt.nals[target];
+    if (nal->type > HEVC_NAL_CRA_NUT ||
+        (nal->type > HEVC_NAL_RASL_R && nal->type < HEVC_NAL_BLA_W_LP) ||
+        nal->nuh_layer_id == 0 || nal->nuh_layer_id > HEVC_MAX_NUH_LAYER_ID ||
+        s->avctx->skip_frame >= AVDISCARD_ALL ||
+        (s->avctx->skip_frame >= AVDISCARD_NONREF && ff_hevc_nal_is_nonref(nal->type)))
+        return;
+
+    layer_idx = s->vps->layer_idx[nal->nuh_layer_id];
+    if (layer_idx <= 0 || !(s->layers_active_decode & (1 << layer_idx)))
+        return;
+    l = &s->layers[layer_idx];
+    if (l->cur_frame || l->prestarted)
+        return;
+
+    picture_state_take(s, &base);
+    swap_slice_headers(s);
+
+    s->nal_unit_type = nal->type;
+    s->nuh_layer_id  = nal->nuh_layer_id;
+    s->temporal_id   = nal->temporal_id;
+
+    gb  = nal->gb;
+    ret = hls_slice_header(&s->sh, s, &gb);
+    if (ret >= 0 && s->sh.first_slice_in_pic_flag && !slice_is_skipped(s)) {
+        ret = hevc_frame_start(s, l, target);
+        if (ret >= 0) {
+            picture_state_take(s, &l->prestart);
+            l->prestarted = 1;
+        }
+    }
+
+    // a picture not started here starts when decoding reaches its slice,
+    // as it would without this
+    av_refstruct_unref(&s->pps);
+    swap_slice_headers(s);
+    picture_state_put(s, &base);
+}
+
+/* drop the state of pictures started ahead of slices decoding never reached;
+ * such a picture holds no decoded data, so it is neither shown nor kept for
+ * reference */
+static void prestart_reset(HEVCContext *s)
+{
+    for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
+        HEVCLayerContext *l = &s->layers[i];
+
+        if (!l->prestarted)
+            continue;
+
+        av_refstruct_unref(&l->prestart.pps);
+        l->prestarted = 0;
+        if (l->cur_frame) {
+            // a thread decoding the next access unit may already wait on it
+            ff_progress_frame_report(&l->cur_frame->tf, INT_MAX);
+            ff_hevc_unref_frame(l->cur_frame, ~0);
+            l->cur_frame = NULL;
+        }
+    }
+}
+
 static int decode_slice(HEVCContext *s, unsigned nal_idx, GetBitContext *gb)
 {
     const int layer_idx = s->vps ? s->vps->layer_idx[s->nuh_layer_id] : 0;
@@ -3544,11 +3702,7 @@ static int decode_slice(HEVCContext *s, unsigned nal_idx, GetBitContext *gb)
         return ret;
     }
 
-    if ((s->avctx->skip_frame >= AVDISCARD_BIDIR && s->sh.slice_type == HEVC_SLICE_B) ||
-        (s->avctx->skip_frame >= AVDISCARD_NONINTRA && s->sh.slice_type != HEVC_SLICE_I) ||
-        (s->avctx->skip_frame >= AVDISCARD_NONKEY && !IS_IRAP(s)) ||
-        ((s->nal_unit_type == HEVC_NAL_RASL_R || s->nal_unit_type == HEVC_NAL_RASL_N) &&
-         s->no_rasl_output_flag)) {
+    if (slice_is_skipped(s)) {
         if (s->sh.first_slice_in_pic_flag)
             s->skipping_frame = 1;
         return 0;
@@ -3566,14 +3720,22 @@ static int decode_slice(HEVCContext *s, unsigned nal_idx, GetBitContext *gb)
     l = &s->layers[s->cur_layer];
 
     if (s->sh.first_slice_in_pic_flag) {
-        if (l->cur_frame) {
-            av_log(s->avctx, AV_LOG_ERROR, "Two slices reporting being the first in the same frame.\n");
-            return AVERROR_INVALIDDATA;
-        }
+        if (l->prestarted) {
+            picture_state_put(s, &l->prestart);
+            l->prestarted = 0;
+        } else {
+            if (l->cur_frame) {
+                av_log(s->avctx, AV_LOG_ERROR, "Two slices reporting being the first in the same frame.\n");
+                return AVERROR_INVALIDDATA;
+            }
 
-        ret = hevc_frame_start(s, l, nal_idx);
-        if (ret < 0)
-            return ret;
+            ret = hevc_frame_start(s, l, nal_idx);
+            if (ret < 0)
+                return ret;
+
+            if (l == &s->layers[0])
+                prestart_layer_picture(s, nal_idx);
+        }
     } else if (!l->cur_frame) {
         av_log(s->avctx, AV_LOG_ERROR, "First slice in a frame missing.\n");
         return AVERROR_INVALIDDATA;
@@ -3785,6 +3947,8 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
     }
 
 fail:
+    prestart_reset(s);
+
     for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
         HEVCLayerContext *l = &s->layers[i];
 
@@ -3962,6 +4126,9 @@ static av_cold int hevc_decode_free(AVCodecContext *avctx)
     av_freep(&s->sh.entry_point_offset);
     av_freep(&s->sh.offset);
     av_freep(&s->sh.size);
+    av_freep(&s->sh_prestart.entry_point_offset);
+    av_freep(&s->sh_prestart.offset);
+    av_freep(&s->sh_prestart.size);
 
     av_freep(&s->local_ctx);
 
diff --git a/libavcodec/hevc/hevcdec.h b/libavcodec/hevc/hevcdec.h
index b21d82b..e16226e 100644
--- a/libavcodec/hevc/hevcdec.h
+++ b/libavcodec/hevc/hevcdec.h
@@ -449,10 +449,34 @@ typedef struct HEVCLocalContext {
     char padding[128];
 } HEVCLocalContext;
 
+/**
+ * Per-picture decoding state that lives in HEVCContext while one layer's
+ * picture is being decoded. Saved and restored when a non-base layer's
+ * picture is started ahead of its slices.
+ */
+typedef struct HEVCPictureState {
+    const HEVCPPS *pps; ///< RefStruct reference
+    enum HEVCNALUnitType nal_unit_type;
+    enum HEVCNALUnitType first_nal_type;
+    int nuh_layer_id;
+    int temporal_id;
+    int poc;
+    int slice_idx;
+    HEVCFrame *cur_frame;
+    HEVCFrame *collocated_ref;
+    RefPicList rps[NB_RPS_TYPE];
+    int end_of_tiles_x;
+} HEVCPictureState;
+
 typedef struct HEVCLayerContext {
     HEVCFrame               DPB[32];
     HEVCFrame              *cur_frame;
 
+    // set while this layer's picture was started ahead of its first slice,
+    // until decoding reaches that slice; prestart holds its picture state
+    int                     prestarted;
+    HEVCPictureState        prestart;
+
     const HEVCSPS          *sps; // RefStruct reference
 
     int                     bs_width;
@@ -517,6 +541,9 @@ typedef struct HEVCContext {
     const HEVCVPS *vps; ///< RefStruct reference
     const HEVCPPS *pps; ///< RefStruct reference
     SliceHeader sh;
+    // scratch slice header for a non-base layer picture started ahead of
+    // its slices, so the base layer's header stays intact
+    SliceHeader sh_prestart;
     enum HEVCNALUnitType nal_unit_type;
     int temporal_id;  ///< temporal_id_plus1 - 1
     HEVCFrame *cur_frame;
-- 
2.43.0

